{
  "name": "delux-tpm-crm",
  "version": "1.2.0",
  "description": "Delux TPM CRM powered by AusGreek Developments",
  "author": "AusGreek Developments",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:msix": "electron-builder --win msix",
    "build:appimage": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --win --mac --linux --dir"
  },
  "build": {
    "appId": "com.ausgreek.deluxtpmcrm",
    "productName": "Delux TPM CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "../dist/frontend/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msix",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "publisherName": "AusGreek Developments"
    },
    "electronSign": {
      "publisherName": "AusGreek Developments"
    },
    "msix": {
      "createCertificate": true,
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "AusGreek Developments"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": null,
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
