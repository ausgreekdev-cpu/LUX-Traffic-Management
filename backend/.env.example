# Delux TPM CRM — Backend Env Template
JWT_SECRET=generate-with: openssl rand -base64 32
DATABASE_URL=./data/tmpcms.db
CORS_ORIGIN=http://localhost:5173

# Stripe Billing (Web) — base plans + extra seats beyond included (Starter 2, Pro 5, Agency 15 at $39/$39/$29)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_AGENCY_MONTHLY=price_agency_monthly
STRIPE_PRICE_STARTER_ANNUAL=price_starter_annual
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
STRIPE_PRICE_AGENCY_ANNUAL=price_agency_annual
# Optional extra-seat price IDs (if set, checkout uses them as second line item; else inline price_data is used)
# STRIPE_PRICE_STARTER_EXTRA_MONTHLY=price_starter_extra_monthly
# STRIPE_PRICE_STARTER_EXTRA_ANNUAL=price_starter_extra_annual
# STRIPE_PRICE_PRO_EXTRA_MONTHLY=price_pro_extra_monthly
# STRIPE_PRICE_PRO_EXTRA_ANNUAL=price_pro_extra_annual
# STRIPE_PRICE_AGENCY_EXTRA_MONTHLY=price_agency_extra_monthly
# STRIPE_PRICE_AGENCY_EXTRA_ANNUAL=price_agency_extra_annual
# Generic fallback for any tier: STRIPE_PRICE_EXTRA_SEAT_MONTHLY / _ANNUAL
APP_URL=https://delux-tpm.netlify.app

# RevenueCat (Mobile) — webhook verification uses REVENUECAT_WEBHOOK_SECRET (Authorization: Bearer <secret>)
REVENUECAT_WEBHOOK_SECRET=xxx

# Mapbox (GIS)
MAPBOX_TOKEN=pk.xxx

# SMTP
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=noreply@ausgreek.dev
EMAIL_PASS=xxx
EMAIL_FROM=Delux TPM CRM <noreply@ausgreek.dev>
