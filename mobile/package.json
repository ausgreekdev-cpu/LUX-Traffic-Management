{
  "name": "lux-traffic-mobile",
  "version": "1.2.2",
  "description": "LUX Traffic Management — mobile field app (Capacitor wrap of the web frontend)",
  "private": true,
  "scripts": {
    "build": "cd ../frontend && npm run build && cd ../mobile && cap sync",
    "sync": "cap sync",
    "android:open": "cap open android",
    "android:apk": "cd android && gradlew assembleDebug",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
