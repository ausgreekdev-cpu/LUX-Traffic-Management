# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# must never be committed. The app also reads the same keys from the database
# settings (Settings -> Email), which override these environment variables at
# runtime. On Netlify, set these as environment variables on the site instead.
#
# Microsoft 365 Business SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailbox@yourdomain.onmicrosoft.com
SMTP_PASSWORD=your_password_here
SMTP_FROM_NAME=Ausgreek Development System
SMTP_FROM_EMAIL=your_mailbox@yourdomain.onmicrosoft.com
# Optional: override the TLS cipher list (empty = Node default TLS 1.2+)
#SMTP_CIPHERS=

# Optional: Postmark (used automatically when a token is saved in Settings)
#POSTMARK_API_TOKEN=
#POSTMARK_FROM_NAME=
#POSTMARK_FROM_EMAIL=
#POSTMARK_MESSAGE_STREAM=outbound