# Netlify Environment Variables Template
# Copy to Netlify Dashboard → Site Settings → Environment Variables

# Required - Authentication
JWT_SECRET=generate-with: openssl rand -base64 32

# Required - Email (SMTP)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your-email@domain.com
EMAIL_PASS=your-app-password
EMAIL_FROM=LUX Traffic <noreply@yourdomain.com>

# Required - Company Branding
COMPANY_NAME=Delux TPM CRM
COMPANY_ADDRESS=Perth WA 6000
COMPANY_PHONE=+61 8 9000 0000
COMPANY_EMAIL=info@ausgreek.dev
POWERED_BY=AusGreek Developments

# Optional - Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAPBOX_TOKEN=sk.xxxxxxxxxxxxx

# Stripe Billing — base plans + extra seats (see backend/src/saas/tiers.js)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_AGENCY_MONTHLY=price_xxx
STRIPE_PRICE_STARTER_ANNUAL=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_AGENCY_ANNUAL=price_xxx
# Optional extra-seat price IDs (fallback is inline price_data at $39/$39/$29)
# STRIPE_PRICE_STARTER_EXTRA_MONTHLY=price_xxx
# STRIPE_PRICE_STARTER_EXTRA_ANNUAL=price_xxx
# STRIPE_PRICE_PRO_EXTRA_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_EXTRA_ANNUAL=price_xxx
# STRIPE_PRICE_AGENCY_EXTRA_MONTHLY=price_xxx
# STRIPE_PRICE_AGENCY_EXTRA_ANNUAL=price_xxx

# RevenueCat — webhook verification (header Authorization: Bearer <secret>)
REVENUECAT_WEBHOOK_SECRET=xxx

# Optional - Feature Flags
ENABLE_PWA=true
ENABLE_ANALYTICS=false