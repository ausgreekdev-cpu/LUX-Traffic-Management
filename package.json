{
  "name": "lux-traffic-management",
  "version": "1.1.0",
  "description": "WA Traffic Management System - TMP & Permit Management",
  "main": "electron/main.js",
  "author": "LUX Traffic Management",
  "license": "MIT",
  "homepage": "https://luxtraffic.com.au",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed",
    "start": "cd backend && npm start",
    "electron:dev": "npm run build:frontend && electron .",
    "electron:build": "npm run build:frontend && electron-builder build --windows",
    "electron:portable": "npm run build:frontend && electron-builder build --win portable"
  },
  "build": {
    "appId": "com.luxtraffic.management",
    "productName": "LUX Traffic Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**",
          "!uploads/**",
          "!.env"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!.cache",
          "!**/{test,tests,__tests__}/**",
          "!**/*.{md,ts,txt,map}",
          "!**/LICENSE*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LUX Traffic Management",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "serverless-http": "^3.2.0",
    "better-sqlite3": "^13.0.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0"
  }
}
