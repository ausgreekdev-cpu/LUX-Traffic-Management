{
  "name": "delux-tpm-crm",
  "version": "1.2.3",
  "description": "Delux TPM CRM powered by AusGreek Developments",
  "main": "electron/main.js",
  "author": "AusGreek Developments",
  "license": "MIT",
  "homepage": "https://lux-official.netlify.app",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed",
    "start": "cd backend && npm start",
    "electron:dev": "npm run build:frontend && electron .",
    "electron:build": "npm run build:frontend && electron-builder build --windows",
    "electron:portable": "npm run build:frontend && electron-builder build --win portable",
    "electron:msix": "npm run build:frontend && electron-builder build --win msix",
    "build:appx-icons": "python3 scripts/generate-appx-icons.py",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "test": "cd backend && npm test",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "build": {
    "appId": "com.ausgreek.deluxtpmcrm",
    "productName": "Delux TPM CRM",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**",
          "!uploads/**",
          "!.env"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!.cache",
          "!**/{test,tests,__tests__}/**",
          "!**/*.{md,ts,txt,map}",
          "!**/LICENSE*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msix",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "appx": {
      "applicationId": "DeluxTPMCRM",
      "backgroundColor": "#111827",
      "displayName": "Delux TPM CRM",
      "identityName": "AusGreekDevelopments.DeluxTPMCRM",
      "publisher": "CN=AusGreek Developments",
      "publisherDisplayName": "AusGreek Developments",
      "languages": ["en-AU", "en-US"],
      "addAutoLaunchExtension": false
    },
    "publish": {
      "provider": "github",
      "owner": "ausgreekdev-cpu",
      "repo": "LUX-Traffic-Management"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Delux TPM CRM",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.12",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "serverless-http": "^3.2.0",
    "stripe": "^14.25.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  }
}
